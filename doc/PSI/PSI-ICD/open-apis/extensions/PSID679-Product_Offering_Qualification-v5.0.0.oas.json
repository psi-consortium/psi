    "components": {
        "schemas": {
            "CheckProductOfferingQualificationStateType": {
                "enum": [
                    "acknowledged",
                    "rejected",
                    "inProgress",
                    "cancelled",
                    "done",
                    "terminatedWithError"
                ],
                "type": "string",
                "description": "Possible values for the state of a task. Named TaskStateType in TMF679; renamed in PSI because PSID687 defines a TaskStateType with other values."
            },
            "CheckProductOfferingQualification_FVO": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Extensible"
                    },
                    {
                        "type": "object",
                        "description": "CheckProductOfferingQualification is used to perform a commercial eligibility. It allows to request an eligibility check for a list of productOfferings (one per item). The response will provide qualification result depending on catalog rules and of the context of the interaction (defined be place, channel, party, product).",
                        "properties": {
                            "channel": {
                                "$ref": "#/components/schemas/ChannelRef"
                            },
                            "description": {
                                "type": "string",
                                "description": "Description of the CheckProductOfferingQualification"
                            },
                            "instantSyncQualification": {
                                "type": "boolean",
                                "description": "An indicator which when the value is true means that the requester expects to get the qualification result immediately in the response. PSID679 answers the creation with 201 whatever its value: the server returns the qualification in its final state with the result where it can qualify it at once, otherwise in state acknowledged.",
                                "deprecated": true
                            },
                            "note": {
                                "type": "array",
                                "description": "Free form text associated with the qualification request",
                                "items": {
                                    "$ref": "#/components/schemas/Note"
                                }
                            },
                            "checkProductOfferingQualificationItem": {
                                "type": "array",
                                "description": "Qualification item for a product or a category",
                                "items": {
                                    "$ref": "#/components/schemas/CheckProductOfferingQualificationItem_FVO"
                                },
                                "minItems": 1
                            },
                            "provideAlternative": {
                                "type": "boolean",
                                "description": "An indicator which when the value is \"true\" means that alternative solutions should be provided"
                            },
                            "provideOnlyAvailable": {
                                "type": "boolean",
                                "description": "An indicator which when the value is true means that only available product offerings must be listed in the response: alternateProductOfferingProposal then lists only alternatives that can be delivered. The items of the qualification are always returned."
                            },
                            "provideResultReason": {
                                "type": "boolean",
                                "description": "An indicator which when the value is \"true\" means that result reason are expected for available or not of product offering"
                            },
                            "relatedParty": {
                                "type": "array",
                                "description": "Party playing a role for this qualification (as requester for example)",
                                "items": {
                                    "$ref": "#/components/schemas/RelatedPartyOrPartyRole_FVO"
                                }
                            },
                            "requestedQualificationCompletionDate": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Deadline date when the requester expected a qualification answer"
                            }
                        },
                        "required": [
                            "checkProductOfferingQualificationItem"
                        ]
                    }
                ],
                "discriminator": {
                    "propertyName": "@type",
                    "mapping": {
                        "CheckProductOfferingQualification": "#/components/schemas/CheckProductOfferingQualification_FVO"
                    }
                }
            },
            "QualificationItemResultType": {
                "type": "string",
                "description": "PSI closed vocabulary for the result of a qualification item, fixed for interoperability between PSSs and providers. green = the provider can deliver the requested product offering or product specification as requested (configuration, place and date); no alternatives are proposed. yellow = the provider cannot fully confirm that it can deliver the item as requested; alternatives may be proposed. red = the provider cannot deliver the item as requested; alternatives may be proposed. Alternatives are carried in alternateProductOfferingProposal. For an item that contains other items (a bundle) the result is derived from the contained items: red as soon as any completed contained item is red; once every contained item is completed, yellow if any of them is yellow, otherwise green; absent until then. Replaces the free-form string of TMF679 v5; the values follow the example TMF679 v5 gives for the overall result and the serviceabilityConfidence of MEF LSO Sonata.",
                "enum": [
                    "green",
                    "yellow",
                    "red"
                ]
            },
            "QualificationResultType": {
                "type": "string",
                "description": "PSI closed vocabulary for the result of the whole qualification request; same values and meaning as QualificationItemResultType, fixed for interoperability. The result is red as soon as any completed item is red; once every item is completed, yellow if any item is yellow, otherwise green; absent until then. Replaces the free-form string of TMF679 v5.",
                "enum": [
                    "green",
                    "yellow",
                    "red"
                ]
            }
        },
