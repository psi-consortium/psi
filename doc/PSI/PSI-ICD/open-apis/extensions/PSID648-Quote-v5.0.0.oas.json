    "components": {
        "schemas": {
            "QuoteStateType": {
                "enum": [
                    "acknowledged",
                    "rejected",
                    "pending",
                    "inProgress",
                    "cancelled",
                    "approved",
                    "accepted",
                    "refused"
                ],
                "type": "string",
                "description": "Possible values for the state of the quote. In PSI, the state in which the customer rejects an approved quote is named refused (rejected in TMF648); rejected is the state of a quote that failed the business validation; declined is not used."
            },
            "QuoteErrorMessage": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Extensible"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "code": {
                                "type": "string",
                                "description": "error code"
                            },
                            "reason": {
                                "type": "string",
                                "description": "Explanation of the reason for the error"
                            },
                            "message": {
                                "type": "string",
                                "description": "More details and corrective actions related to the error"
                            },
                            "status": {
                                "type": "string",
                                "description": "error code extension like sys-ABC-2001"
                            },
                            "referenceError": {
                                "type": "string",
                                "description": "URI of documentation describing the error"
                            },
                            "timestamp": {
                                "type": "string",
                                "description": "Date when the error happened",
                                "format": "date-time"
                            },
                            "quoteItem": {
                                "type": "array",
                                "description": "A list of quote item references corresponded to this error",
                                "items": {
                                    "$ref": "#/components/schemas/QuoteItemRef"
                                }
                            }
                        },
                        "description": "A QuoteErrorMessage represents an error that causes a status change in a quote, as the ProductOrderErrorMessage of TMF622 for a product order."
                    }
                ],
                "discriminator": {
                    "propertyName": "@type",
                    "mapping": {
                        "QuoteErrorMessage": "#/components/schemas/QuoteErrorMessage"
                    }
                }
            },
            "QuoteErrorMessage_FVO": {
