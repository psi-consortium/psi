{
    "openapi": "3.0.1",
    "components": {
        "schemas": {
            "Quote_MVO": {
                "discriminator": {
                    "propertyName": "@type",
                    "mapping": {
                        "Quote": "#/components/schemas/Quote_MVO"
                    }
                },
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Extensible"
                    },
                    {
                        "required": [
                            "state"
                        ],
                        "type": "object",
                        "properties": {
                            "state": {
                                "$ref": "#/components/schemas/QuoteAcceptanceStateType"
                            }
                        },
                        "description": "Quote can be used to negotiate service and product acquisition or modification between a customer and a service provider. A Quote contain list of quote items, a reference to customer (partyRole), a list of productOffering and attached prices and conditions. In PSI, a Quote can only be modified to accept or decline it."
                    }
                ]
            },
            "QuoteAcceptanceStateType": {
                "type": "string",
                "description": "Possible values for the state of the quote set by the requester to accept or decline the quote",
                "enum": [
                    "accepted",
                    "declined"
                ]
            }
        }
    }
}
